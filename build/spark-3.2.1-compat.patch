+package org.apache.gluten.utils
+
+import org.apache.spark.sql.catalyst.expressions.PlanExpression
+import org.apache.spark.sql.execution.SparkPlan
+
+object SubqueryTransformUtil {
+
+  /**
+   * Same semantics as Spark 3.2.2+ `QueryPlan.transformWithSubqueries` (pre-order transform that
+   * also descends into subquery plans), built only on APIs present in Spark 3.2.0/3.2.1, which
+   * lack that method.
+   */
+  def transformDownWithSubqueries(plan: SparkPlan)(
+      f: PartialFunction[SparkPlan, SparkPlan]): SparkPlan = {
+    plan.transformDown {
+      case p =>
+        val transformed = f.applyOrElse[SparkPlan, SparkPlan](p, identity)
+        transformed.transformExpressionsDown {
+          case pe: PlanExpression[_] if pe.plan.isInstanceOf[SparkPlan] =>
+            val sub = pe.asInstanceOf[PlanExpression[SparkPlan]]
+            sub.withNewPlan(transformDownWithSubqueries(sub.plan)(f))
+        }
+    }
+  }
+}
